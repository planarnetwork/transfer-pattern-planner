{
  "name": "transfer-pattern-planner",
  "version": "3.0.0",
  "description": "Transfer Pattern Planning Algorithm",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/Container.d.ts",
        "default": "./dist/esm/Container.js"
      },
      "require": {
        "types": "./dist/cjs/Container.d.ts",
        "default": "./dist/cjs/Container.js"
      }
    },
    "./generate": {
      "import": {
        "types": "./dist/esm/generate/index.d.ts",
        "default": "./dist/esm/generate/index.js"
      },
      "require": {
        "types": "./dist/cjs/generate/index.d.ts",
        "default": "./dist/cjs/generate/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/transfer-pattern-planner.git"
  },
  "scripts": {
    "test": "npm run lint && npm run typecheck && vitest run",
    "watch-test": "vitest",
    "lint": "biome lint src/ test/",
    "typecheck": "tsc --noEmit -p ./",
    "build": "rm -rf ./dist/ && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && cp cjs-package.json dist/cjs/package.json && cp esm-package.json dist/esm/package.json",
    "prepublishOnly": "npm run build",
    "start": "tsx src/cli/plan.ts",
    "patterns": "NODE_OPTIONS='--max-old-space-size=6000' tsx src/cli/transfer-patterns.ts",
    "pattern-files": "NODE_OPTIONS='--max-old-space-size=6000' tsx src/cli/pattern-files.ts",
    "perf": "NODE_OPTIONS=--max-old-space-size=4000 tsx test/performance.ts"
  },
  "keywords": [
    "Journey",
    "Planning",
    "Public",
    "Transport"
  ],
  "author": "Linus Norton <linusnorton@gmail.com>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/transfer-pattern-planner/issues"
  },
  "homepage": "https://github.com/planarnetwork/transfer-pattern-planner#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.5.0",
    "@types/progress": "2.0.7",
    "progress": "2.0.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@gb-transit/gtfs-loader": "^1.1.0",
    "raptor-journey-planner": "^5.0.1"
  }
}
